{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "eprisjournal",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "eprisjournal-verify",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5174",
        "--force"
      ],
      "port": 5174
    },
    {
      "name": "epris-admin-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8123",
        "--directory",
        "public/admin"
      ],
      "port": 8123
    }
  ]
}